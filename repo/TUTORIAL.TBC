PRINT "TINY BASIC QUICK START"
PRINT "PRINT SHOWS TEXT OR A VARIABLE"
PRINT "LET A = 10 STORES A NUMBER"
PRINT "ADD A 2 ADDS TWO TO A"
PRINT "SUB A 1 SUBTRACTS ONE"
PRINT "VARIABLES USE LETTERS A THROUGH Z"
PRINT "FILE READS A DISK FILE"
PRINT "FETCH READS A TINYREPO PATH"
PRINT "TRY FETCH /REPO.JSON"
